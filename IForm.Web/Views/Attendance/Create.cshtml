@model AttendanceFormViewModel
@{
    ViewData["Title"] = "Record Attendance";
    ViewData["PageTitle"] = "Record Attendance";
    ViewData["PageSubtitle"] = "Hours and status are derived; 6+ hours is a full day, 3-6 is a half day";
    ViewData["ActiveMenu"] = "hr-attendance";
}

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <input type="hidden" asp-for="Id" />

    <div class="card mb-2">
        <div class="card-header"><h2>Attendance entry</h2></div>
        <div class="card-body">
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="EmployeeId">Employee</label>
                    <select asp-for="EmployeeId" asp-items="Model.EmployeeOptions" class="form-control">
                        <option value="">Select employee</option>
                    </select>
                    <span asp-validation-for="EmployeeId" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Date"></label>
                    <input asp-for="Date" type="date" class="form-control" />
                    <span asp-validation-for="Date" class="text-danger"></span>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="CheckIn">Check in</label>
                    <input asp-for="CheckIn" type="datetime-local" class="form-control" />
                    <span asp-validation-for="CheckIn" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="CheckOut">Check out</label>
                    <input asp-for="CheckOut" type="datetime-local" class="form-control" />
                    <span asp-validation-for="CheckOut" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Notes"></label>
                <input asp-for="Notes" class="form-control" placeholder="Optional note, e.g. site visit" />
            </div>
            <p class="text-muted small mb-0">
                Leave both times empty to record an absence. A day cannot exceed @AttendanceCalculator.MaxHoursPerDay.ToString("0") hours.
            </p>
        </div>
    </div>

    <div class="form-actions mt-2">
        <button type="submit" class="btn btn-primary">Save Attendance</button>
        <a class="btn btn-outline" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}