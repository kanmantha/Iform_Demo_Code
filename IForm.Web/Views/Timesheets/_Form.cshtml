@model TimesheetFormViewModel
@{
    var formAction = ViewData["FormAction"] as string ?? "Create";
}

<form asp-action="@formAction" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    @if (Model.Id > 0)
    {
        <input type="hidden" asp-for="Id" />
    }

    <div class="card mb-2">
        <div class="card-body">
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="EmployeeId">Employee</label>
                    <select asp-for="EmployeeId" class="form-control">
                        <option value="">Select employee</option>
                        @foreach (var employee in Model.Employees)
                        {
                            <option value="@employee.Id">@employee.FullName</option>
                        }
                    </select>
                    <span asp-validation-for="EmployeeId" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ProjectId">Project</label>
                    <select asp-for="ProjectId" class="form-control">
                        <option value="">No project</option>
                        @foreach (var project in Model.Projects)
                        {
                            <option value="@project.Id">@project.Name</option>
                        }
                    </select>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Date"></label>
                    <input asp-for="Date" type="date" class="form-control" />
                    <span asp-validation-for="Date" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Hours"></label>
                    <input asp-for="Hours" type="number" step="0.25" class="form-control" />
                    <span asp-validation-for="Hours" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Status"></label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<TimesheetStatus>()" class="form-control"></select>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Notes"></label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="form-actions mt-2">
        <button type="submit" class="btn btn-primary">@(Model.Id > 0 ? "Save changes" : "Create Timesheet")</button>
        <a class="btn btn-outline" asp-action="Index">Cancel</a>
    </div>
</form>
