@model EngagementListViewModel
@{
    ViewData["Title"] = "Engagement";
    ViewData["PageTitle"] = "Engagement Surveys";
    ViewData["ActiveMenu"] = "hr-engagement";
}

<div class="page-header">
    <div>
        <h1>Engagement Surveys</h1>
        <p class="text-muted">@Model.TotalCount survey(s) on record.</p>
    </div>
    <div class="page-actions">
        <a asp-action="Create" class="btn btn-primary">New Survey</a>
    </div>
</div>

<div class="card">
    <div class="card-body">
        <form method="get" class="row g-3 mb-4">
            <div class="col-md-4">
                <label class="form-label">Search</label>
                <input asp-for="Search" class="form-control" placeholder="Search by title" />
            </div>
            <div class="col-md-3">
                <label class="form-label">Status</label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<EngagementStatus>()" class="form-select">
                    <option value="">All</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-outline w-100">Filter</button>
            </div>
        </form>

        @if (Model.Surveys.Count == 0)
        {
            <p class="text-muted mb-0">No surveys found.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Status</th>
                            <th>Start Date</th>
                            <th>End Date</th>
                            <th>Created</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in Model.Surveys)
                        {
                            <tr>
                                <td>@s.Title</td>
                                <td>@s.Status</td>
                                <td>@s.StartDate.ToString("dd MMM yyyy")</td>
                                <td>@(s.EndDate?.ToString("dd MMM yyyy") ?? "-")</td>
                                <td>@s.CreatedAt.ToString("dd MMM yyyy")</td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline">View</a>
                                    <a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-sm btn-outline">Edit</a>
                                    <form asp-action="Delete" asp-route-id="@s.Id" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this survey?');">
                                        <button class="btn btn-sm btn-danger">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
