@model List<OnboardingTemplate>
@{
    ViewData["Title"] = "Onboarding Templates";
    ViewData["PageTitle"] = "Onboarding Templates";
    ViewData["PageSubtitle"] = "Reusable checklists copied into each new hire's record";
    ViewData["ActiveMenu"] = "hr-onboarding";
}

<div class="page-actions">
    <a asp-action="CreateTemplate" class="btn btn-primary">New Template</a>
    <a asp-action="Index" class="btn btn-outline">Back to Checklists</a>
</div>

@if (Model.Count == 0)
{
    <div class="card"><div class="card-body text-muted">No templates yet.</div></div>
}
else
{
    @foreach (var template in Model)
    {
        <div class="card mb-2">
            <div class="card-header">
                <h2>@template.Name</h2>
                <span class="status-chip status-@(template.IsActive ? "active" : "inactive")">@(template.IsActive ? "Active" : "Inactive")</span>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(template.Description))
                {
                    <p class="text-muted">@template.Description</p>
                }
                <ul class="mb-0">
                    @foreach (var task in template.TaskTemplates.OrderBy(t => t.DisplayOrder))
                    {
                        <li>@task.Title <span class="text-muted">(day @task.DueDayOffset)</span></li>
                    }
                </ul>
            </div>
        </div>
    }
}