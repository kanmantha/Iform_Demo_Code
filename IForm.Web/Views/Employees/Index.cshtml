@model EmployeeListViewModel
@{
    ViewData["Title"] = "Employee Directory";
}

<div class="page-header">
    <div>
        <h1>Employee Directory</h1>
        <p class="text-muted">@Model.TotalCount employee(s) on record, @Model.ActiveCount active, @Model.ExitedCount exited.</p>
    </div>
    <a asp-controller="Employees" asp-action="Create" class="btn btn-primary">Add Employee</a>
</div>

<form method="get" asp-action="Index" class="card card-body mb-3">
    <div class="filter-bar">
        <div>
            <label for="Search">Search</label>
            <input type="text" id="Search" name="search" value="@Model.Search" class="form-control" placeholder="Name, email or code" />
        </div>
        <div>
            <label for="DepartmentId">Department</label>
            <select id="DepartmentId" name="departmentId" class="form-control">
                <option value="">All departments</option>
                @foreach (var department in Model.Departments)
                {
                    <option value="@department.Id" selected="@(Model.DepartmentId == department.Id)">@department.Name</option>
                }
            </select>
        </div>
        <div>
            <label for="Status">Status</label>
            <select id="Status" name="status" class="form-control">
                <option value="">Any status</option>
                @foreach (var status in Enum.GetValues<EmploymentStatus>())
                {
                    <option value="@status" selected="@(Model.Status == status)">@status</option>
                }
            </select>
        </div>
        <div class="filter-actions">
            <button type="submit" class="btn btn-outline-primary">Apply</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </div>
</form>

<div class="card">
    @if (Model.Employees.Count == 0)
    {
        <div class="card-body text-muted">No employees match the current filters.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Department</th>
                        <th>Job Title</th>
                        <th>Reports To</th>
                        <th>Joined</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var employee in Model.Employees)
                    {
                        <tr>
                            <td><code>@employee.EmployeeCode</code></td>
                            <td>
                                <a asp-action="Details" asp-route-id="@employee.Id">@employee.FullName</a>
                                <div class="text-muted small">@employee.Email</div>
                            </td>
                            <td>@(employee.Department?.Name ?? "-")</td>
                            <td>@(employee.JobTitle ?? "-")</td>
                            <td>@(employee.Manager?.FullName ?? "-")</td>
                            <td>@(employee.DateJoined?.ToString("dd MMM yyyy") ?? "-")</td>
                            <td><span class="status-chip status-@employee.Status.ToString().ToLowerInvariant()">@employee.Status</span></td>
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@employee.Id" class="btn btn-sm btn-outline-secondary">Edit</a>
                                <form method="post" asp-action="SetStatus" asp-route-id="@employee.Id" class="d-inline">
                                    <input type="hidden" name="status" value="@(employee.Status == EmploymentStatus.Exited ? EmploymentStatus.Active : EmploymentStatus.Exited)" />
                                    <button type="submit" class="btn btn-sm btn-outline-warning">
                                        @(employee.Status == EmploymentStatus.Exited ? "Reinstate" : "Mark Exited")
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>