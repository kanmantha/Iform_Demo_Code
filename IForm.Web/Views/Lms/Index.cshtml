@model LmsListViewModel
@{
    ViewData["Title"] = "LMS";
    ViewData["PageTitle"] = "LMS";
    ViewData["ActiveMenu"] = "hr-lms";
}

<div class="page-header">
    <div>
        <h1>LMS Courses</h1>
        <p class="text-muted">@Model.TotalCount course(s) on record.</p>
    </div>
    <a asp-controller="Lms" asp-action="Create" class="btn btn-primary">Add Course</a>
</div>

<form method="get" asp-action="Index" class="card card-body mb-3">
    <div class="filter-bar">
        <div>
            <label for="Search">Search</label>
            <input type="text" id="Search" name="search" value="@Model.Search" class="form-control" placeholder="Title" />
        </div>
        <div>
            <label for="Status">Status</label>
            <select id="Status" name="status" class="form-control">
                <option value="">Any status</option>
                @foreach (var status in Enum.GetValues<LmsStatus>())
                {
                    <option value="@status" selected="@(Model.Status == status)">@status</option>
                }
            </select>
        </div>
        <div class="filter-actions">
            <button type="submit" class="btn btn-outline-primary">Apply</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Reset</a>
        </div>
    </div>
</form>

<div class="card">
    @if (Model.Courses.Count == 0)
    {
        <div class="card-body text-muted">No courses match the current filters.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Status</th>
                        <th>Duration (hrs)</th>
                        <th>Created</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var course in Model.Courses)
                    {
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@course.Id">@course.Title</a></td>
                            <td>@course.Status</td>
                            <td>@(course.DurationHours?.ToString() ?? "-")</td>
                            <td>@course.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@course.Id" class="btn btn-sm btn-outline">View</a>
                                <a asp-action="Edit" asp-route-id="@course.Id" class="btn btn-sm btn-outline">Edit</a>
                                <form asp-action="Delete" asp-route-id="@course.Id" method="post" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this course?')">Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
