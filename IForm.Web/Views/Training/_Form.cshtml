@model TrainingFormViewModel
@{
    var formAction = ViewData["FormAction"] as string ?? "Create";
}

<form asp-action="@formAction" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    @if (Model.Id > 0)
    {
        <input type="hidden" asp-for="Id" />
    }

    <div class="card mb-2">
        <div class="card-body">
            <div class="form-group">
                <label asp-for="Title"></label>
                <input asp-for="Title" class="form-control" />
                <span asp-validation-for="Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description"></label>
                <textarea asp-for="Description" class="form-control" rows="2"></textarea>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="Type"></label>
                    <select asp-for="Type" asp-items="Html.GetEnumSelectList<TrainingType>()" class="form-control"></select>
                </div>
                <div class="form-group">
                    <label asp-for="Status"></label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<TrainingStatus>()" class="form-control"></select>
                </div>
                <div class="form-group">
                    <label asp-for="TrainerEmployeeId">Trainer</label>
                    <select asp-for="TrainerEmployeeId" class="form-control">
                        <option value="">None</option>
                        @foreach (var trainer in Model.Trainers)
                        {
                            <option value="@trainer.Id">@trainer.FullName</option>
                        }
                    </select>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="StartDate"></label>
                    <input asp-for="StartDate" type="date" class="form-control" />
                </div>
                <div class="form-group">
                    <label asp-for="EndDate"></label>
                    <input asp-for="EndDate" type="date" class="form-control" />
                </div>
            </div>
        </div>
    </div>

    <div class="form-actions mt-2">
        <button type="submit" class="btn btn-primary">@(Model.Id > 0 ? "Save changes" : "Create Training")</button>
        <a class="btn btn-outline" asp-action="Index">Cancel</a>
    </div>
</form>
