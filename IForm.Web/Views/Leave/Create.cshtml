@model LeaveRequestFormViewModel
@{
    ViewData["Title"] = "Request Leave";
    ViewData["PageTitle"] = "Request Leave";
    ViewData["PageSubtitle"] = "Working days exclude weekends; the request starts as pending";
    ViewData["ActiveMenu"] = "hr-leave";
}

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-2"></div>
    <input type="hidden" asp-for="Id" />

    <div class="card mb-2">
        <div class="card-header"><h2>Leave details</h2></div>
        <div class="card-body">
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="EmployeeId">Employee</label>
                    <select asp-for="EmployeeId" asp-items="Model.EmployeeOptions" class="form-control">
                        <option value="">Select employee</option>
                    </select>
                    <span asp-validation-for="EmployeeId" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="LeaveType"></label>
                    <select asp-for="LeaveType" asp-items="Html.GetEnumSelectList<LeaveType>()" class="form-control"></select>
                    <span asp-validation-for="LeaveType" class="text-danger"></span>
                </div>
            </div>
            <div class="form-row">
                <div class="form-group">
                    <label asp-for="StartDate"></label>
                    <input asp-for="StartDate" type="date" class="form-control" />
                    <span asp-validation-for="StartDate" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="EndDate"></label>
                    <input asp-for="EndDate" type="date" class="form-control" />
                    <span asp-validation-for="EndDate" class="text-danger"></span>
                </div>
            </div>
            <div class="form-group">
                <label asp-for="Reason"></label>
                <textarea asp-for="Reason" class="form-control" rows="2" placeholder="Why is this leave needed?"></textarea>
                <span asp-validation-for="Reason" class="text-danger"></span>
            </div>
        </div>
    </div>

    <div class="form-actions mt-2">
        <button type="submit" class="btn btn-primary">Submit Request</button>
        <a class="btn btn-outline" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}